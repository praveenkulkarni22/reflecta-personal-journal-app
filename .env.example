# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY or GOOGLE_MAPS_API_KEY: Optional Google Maps Platform API Key for location tagging and interactive maps.
# Users can provide their own key or mint a free prototyping key at:
# https://mapsplatform.google.com/maps-demo-key?utm_campaign=gmp_mcp_codeassist_v1_aistudio
VITE_GOOGLE_MAPS_API_KEY=""
GOOGLE_MAPS_API_KEY=""

# ADMIN_EMAILS: MANDATORY comma-separated list of bootstrap administrator email addresses.
# On first sign-in, users with these emails are granted Admin roles to bootstrap the system.
# Example: ADMIN_EMAILS="admin1@example.com,admin2@example.com"
ADMIN_EMAILS=""

# EMAIL NOTIFICATIONS CONFIGURATION (Optional for production inbox delivery):
# Option 1: Direct SMTP (Gmail App Passwords, SendGrid, Amazon SES, Mailgun, Postmark, custom)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM=""

# Option 2: Resend API (Free 3,000 emails/month)
RESEND_API_KEY=""

# Option 3: SendGrid API
SENDGRID_API_KEY=""

